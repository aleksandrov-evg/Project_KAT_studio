# PostgreSQL доступен сервису уведомлений только через SSH-контейнер из Compose.
# Специальные символы в имени пользователя и пароле должны быть URL-кодированы.
DATABASE_URL=postgresql://db_user:db_password@ssh-tunnel:15432/database_name

# Параметры SSH-подключения к серверу, из которого доступна база данных.
SSH_HOST=bastion.example.com
SSH_PORT=22
SSH_USER=deploy
# Приватный SSH-ключ в Base64, одной строкой. Никогда не добавляйте настоящий ключ в Git.
SSH_PRIVATE_KEY_BASE64=replace_with_base64_private_key
# Проверенная строка known_hosts для SSH_HOST, закодированная в Base64.
SSH_KNOWN_HOSTS_BASE64=replace_with_base64_known_hosts
# Хост базы определяется относительно SSH-сервера, а не контейнера уведомлений.
DB_REMOTE_HOST=127.0.0.1
DB_REMOTE_PORT=5432

# Данные Telegram-бота и закрытой супергруппы (ops), куда приходят заявки и кнопки.
TELEGRAM_BOT_TOKEN=1234567890:replace_with_bot_token
TELEGRAM_CHAT_ID=-1001234567890

# Необязательно: идентификатор темы в супергруппе с форумом.
TELEGRAM_THREAD_ID=

# polling (по умолчанию) или webhook. Для webhook нужен публичный HTTPS URL на /telegram/webhook.
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

# Whitelist менеджеров: telegram_user_id:Имя,... Пусто = разрешены все в группе.
TELEGRAM_MANAGER_WHITELIST=

# Уникальный ключ экземпляра уведомителя — используется для отслеживания обработанных заявок.
NOTIFIER_KEY=pilates-leads-main
# Интервал проверки новых заявок в миллисекундах.
POLL_INTERVAL_MS=5000
# Максимальное число заявок, обрабатываемых за одну проверку.
BATCH_SIZE=20
# При false старые заявки пропускаются только при первом запуске с этим NOTIFIER_KEY.
SEND_EXISTING=false

# --- Twenty CRM sync + LeadAction API ---
# При true: WF-01 ingest + кнопки/reply вызывают POST /s/studio/lead-actions.
CRM_SYNC_ENABLED=false
CRM_SEND_EXISTING=false
# Base URL инстанса Twenty без завершающего слэша, например https://crm.example.com
TWENTY_API_URL=
TWENTY_API_KEY=
# Публичный URL UI Twenty для deep-link «Открыть в CRM» (может совпадать с API host).
TWENTY_APP_BASE_URL=
