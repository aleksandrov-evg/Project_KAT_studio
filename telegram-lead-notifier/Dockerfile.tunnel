FROM alpine:3.22

RUN sed -i 's|https://dl-cdn.alpinelinux.org/alpine|https://mirror.yandex.ru/mirrors/alpine|' /etc/apk/repositories \
    && for attempt in 1 2 3 4 5; do \
      apk add --no-cache openssh-client netcat-openbsd && break; \
      if [ "$attempt" = 5 ]; then exit 1; fi; \
      sleep 3; \
    done \
    && addgroup -g 1000 tunnel \
    && adduser -D -u 1000 -G tunnel tunnel
COPY ssh-tunnel-entrypoint.sh /usr/local/bin/ssh-tunnel-entrypoint
RUN chmod 755 /usr/local/bin/ssh-tunnel-entrypoint

USER tunnel
ENTRYPOINT ["ssh-tunnel-entrypoint"]
